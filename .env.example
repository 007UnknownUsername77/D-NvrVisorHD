# Copy this file to .env and fill it in. .env is not versioned.
# Inside Docker, compose sets CAM_VIEWER_HOST=0.0.0.0 in the container
# and publishes the port only on 127.0.0.1 of the host.

CAM_VIEWER_HOST=127.0.0.1
CAM_VIEWER_PORT=8090
CAM_VIEWER_ROOT=/var/www/cam-viewer

# Recorder name or address. Empty user and password: the app does not start.
DVR_HOST=RECORDER
DVR_USER=
DVR_PASS=

# 8 is the tested value. Raise it when the recorder has more channels (maximum 64).
VISOR_CHANNELS=8

# 1 opens the page with no recorder. Archive requests return an error.
VISOR_DEMO=0

GO2RTC_URL=http://127.0.0.1:1984
GO2RTC_YAML=/etc/go2rtc/go2rtc.yaml

# Optional report. Empty means nothing is sent.
# The text only carries the count of analog cameras, IP cameras, and untyped ones.
VISOR_REPORT_WEBHOOK=
VISOR_REPORT_TOKEN=
VISOR_REPORT_TO=
VISOR_REPORT_USER_AGENT=VisorDeployReport/1.0
