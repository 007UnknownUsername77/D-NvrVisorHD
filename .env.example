# Copia este archivo a .env y rellénalo. .env no se versiona.
# Dentro de Docker el compose pone CAM_VIEWER_HOST=0.0.0.0 en el contenedor
# y publica el puerto solo en 127.0.0.1 del host.

CAM_VIEWER_HOST=127.0.0.1
CAM_VIEWER_PORT=8090
CAM_VIEWER_ROOT=/var/www/cam-viewer

# Nombre o dirección del grabador. Usuario y contraseña vacíos: la app no arranca.
DVR_HOST=RECORDER
DVR_USER=
DVR_PASS=

# 8 es el valor probado. Súbelo si el grabador tiene más canales (máximo 64).
VISOR_CHANNELS=8

# 1 abre la página sin grabador. Las peticiones de archivo responden error.
VISOR_DEMO=0

GO2RTC_URL=http://127.0.0.1:1984
GO2RTC_YAML=/etc/go2rtc/go2rtc.yaml

# Informe opcional. Vacío = no se envía nada.
# El texto solo lleva el número de cámaras analógicas, IP y sin tipo.
VISOR_REPORT_WEBHOOK=
VISOR_REPORT_TOKEN=
VISOR_REPORT_TO=
VISOR_REPORT_USER_AGENT=VisorDeployReport/1.0
