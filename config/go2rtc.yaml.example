# Plantilla sin credenciales. Cópiala a config/go2rtc.yaml, que no se versiona.
# Cambia USER, PASSWORD y RECORDER. No dejes la contraseña en git.
#
# Dentro de Docker esta plantilla escucha en todas las interfaces del contenedor.
# El compose publica 1984 y 8555 solo en 127.0.0.1 del host, y no publica 8554.
# En un servidor sin Docker cambia api y webrtc a 127.0.0.1 antes de arrancar.
# El RTSP de go2rtc (8554) se queda en localhost.

api:
  listen: ":1984"

rtsp:
  listen: "127.0.0.1:8554"

webrtc:
  listen: ":8555"

ffmpeg:
  # HEVC de rango completo se ve gris si el lector usa low_delay.
  # Esta conversión pasa a rango de TV. No metas format= en el mismo -vf.
  h264/phone: "-vf scale=in_range=pc:out_range=tv -c:v libx264 -g 30 -bf 0 -profile:v high -level:v 5.1 -preset:v superfast -tune:v zerolatency -pix_fmt:v yuv420p -color_range tv"
  rtsp/hd: "-timeout 20000000 -user_agent go2rtc/ffmpeg -rtsp_transport tcp -i {input}"
  rtsp/play: "-re -timeout 20000000 -user_agent go2rtc/ffmpeg -rtsp_transport tcp -i {input}"

streams:
  # Hikvision: canal 1 main = 101, sub = 102. Canal 2 = 201 y 202.
  # Otra marca: usa el RTSP que publique el grabador y el mismo nombre en cameras.json.
  # El nombre _main es obligatorio: la página pide el HD como el mismo nombre acabado en _hd.
  analog_1_sub: "rtsp://USER:PASSWORD@RECORDER:554/Streaming/Channels/102"
  analog_1_main:
    - "rtsp://USER:PASSWORD@RECORDER:554/Streaming/Channels/101"
  analog_1_hd:
    - "ffmpeg:rtsp://USER:PASSWORD@RECORDER:554/Streaming/Channels/101#video=h264/phone#input=rtsp/hd"

  # La IP del ejemplo lleva AAC en el HD. No lo pongas en el reproductor del iPhone:
  # la app ya pide ese reproductor sin audio, porque G.711 frena la primera imagen.
  ip_1_sub: "rtsp://USER:PASSWORD@RECORDER:554/Streaming/Channels/202"
  ip_1_main:
    - "rtsp://USER:PASSWORD@RECORDER:554/Streaming/Channels/201"
  ip_1_hd:
    - "ffmpeg:rtsp://USER:PASSWORD@RECORDER:554/Streaming/Channels/201#video=h264/phone#audio=aac#input=rtsp/hd"

# dvr_playback lo crea la app al abrir una grabación. No lo declares aquí.
# No uses un productor ffmpeg que apunte a su propio nombre.
