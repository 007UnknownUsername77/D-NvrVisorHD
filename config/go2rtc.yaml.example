# Template with no credentials. Copy it to config/go2rtc.yaml, which is not versioned.
# Change USER, PASSWORD, and RECORDER. Do not commit the password.
#
# Inside Docker this template listens on every container interface.
# Compose publishes 1984 and 8555 only on 127.0.0.1 of the host, and does not publish 8554.
# On a server without Docker, change api and webrtc to 127.0.0.1 before starting.
# go2rtc RTSP (8554) stays on localhost.

api:
  listen: ":1984"

rtsp:
  listen: "127.0.0.1:8554"

webrtc:
  listen: ":8555"

ffmpeg:
  # Full-range HEVC looks gray when the reader uses low_delay.
  # This conversion moves the picture to TV range. Do not put format= in the same -vf.
  h264/phone: "-vf scale=in_range=pc:out_range=tv -c:v libx264 -g 30 -bf 0 -profile:v high -level:v 5.1 -preset:v superfast -tune:v zerolatency -pix_fmt:v yuv420p -color_range tv"
  rtsp/hd: "-timeout 20000000 -user_agent go2rtc/ffmpeg -rtsp_transport tcp -i {input}"
  rtsp/play: "-re -timeout 20000000 -user_agent go2rtc/ffmpeg -rtsp_transport tcp -i {input}"

streams:
  # Hikvision: channel 1 main = 101, sub = 102. Channel 2 = 201 and 202.
  # Another brand: use the RTSP URL the recorder publishes, and the same name in cameras.json.
  # The _main name is required: the page asks for HD as that name ending in _hd.
  analog_1_sub: "rtsp://USER:PASSWORD@RECORDER:554/Streaming/Channels/102"
  analog_1_main:
    - "rtsp://USER:PASSWORD@RECORDER:554/Streaming/Channels/101"
  analog_1_hd:
    - "ffmpeg:rtsp://USER:PASSWORD@RECORDER:554/Streaming/Channels/101#video=h264/phone#input=rtsp/hd"

  # The example IP camera carries AAC on HD. Do not put that on the iPhone player:
  # the app already asks for that player without audio, because G.711 stalls the first picture.
  ip_1_sub: "rtsp://USER:PASSWORD@RECORDER:554/Streaming/Channels/202"
  ip_1_main:
    - "rtsp://USER:PASSWORD@RECORDER:554/Streaming/Channels/201"
  ip_1_hd:
    - "ffmpeg:rtsp://USER:PASSWORD@RECORDER:554/Streaming/Channels/201#video=h264/phone#audio=aac#input=rtsp/hd"

# The app creates dvr_playback when a recording opens. Do not declare it here.
# Do not add an ffmpeg producer that points at its own name.
